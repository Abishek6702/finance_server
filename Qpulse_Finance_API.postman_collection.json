{
  "info": {
    "name": "Qpulse Finance API",
    "description": "Complete collection aligned with all backend routes, validations, and realistic body payloads. Covers Auth, Fee Structure, Students, Fee Payment & Tracking, Hostel, and Transport modules.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "const token = pm.environment.get('token');",
          "if (token) pm.request.headers.upsert({ key: 'Authorization', value: `Bearer ${token}` });",
          "",
          "const yyyy = new Date().getFullYear();",
          "if (!pm.environment.get('academic_year')) pm.environment.set('academic_year', `${yyyy}-${yyyy + 1}`);",
          "if (!pm.environment.get('batch_year')) pm.environment.set('batch_year', `${yyyy}-${yyyy + 4}`);",
          "",
          "if (!pm.environment.get('student_roll_no') || pm.environment.get('student_roll_no').length !== 7) {",
          "  const suffix = String(Date.now()).slice(-3);",
          "  pm.environment.set('student_roll_no', `25CS${suffix}`);",
          "}",
          "",
          "if (!pm.environment.get('receipt_no')) {",
          "  const rs = String(Date.now()).slice(-6);",
          "  pm.environment.set('receipt_no', `REC${rs}`);",
          "}"
        ]
      }
    }
  ],
